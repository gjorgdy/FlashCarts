{
  "schemaVersion": 1,
  "id": "flash_carts",
  "version": "${version}",
  "name": "Flash Carts",
  "description": "Faster Minecarts, speedometers, and rail building tools without breaking your Redstone machines or needing client mods!",
  "authors": [
    "Gjorgdy"
  ],
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.modrinth": "https://modrinth.com/mod/flash-carts",
        "modmenu.discord": "https://discord.gg/HmG77BTCux",
        "modmenu.issues": "https://github.com/gjorgdy/FlashCarts/issues"
      },
      "update_checker": true
    }
  },
  "contact": {},
  "license": "CC-BY-NC-SA-4.0",
  "icon": "assets/flashcarts/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "nl.gjorgdy.flashcarts.Flashcarts"
    ]
  },
  "mixins": [
    "flashcarts.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "fzzy-config": ">=${fzzy_config_version}"
  }
}
